{
  "name": "securevault-cloud",
  "version": "1.0.0",
  "description": "Secure Cloud File Storage and Distribution Using File Segmentation, Encryption, and CDN",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm --prefix client run build && npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "start": "npm --prefix server run start",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-report": "python scripts/generate_report.py"
  },
  "keywords": [
    "cloud-storage",
    "aes-256-gcm",
    "pbkdf2",
    "sha-256",
    "aws-s3",
    "cloudfront",
    "file-segmentation",
    "cybersecurity"
  ],
  "author": "Computer Engineering Mini Project Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vitest": "^3.0.7"
  }
}
