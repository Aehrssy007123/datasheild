# =================================================================
# SecureVault Cloud - Environment Configuration
# =================================================================
# NOTE: Do NOT commit your real .env file with secrets to Git!
# Copy this file to .env and configure as needed.

# ----------------- Server Configuration -----------------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ----------------- Storage Provider Configuration -----------------
# Storage provider mode: 's3' or 'local'
# If AWS credentials below are omitted, the server automatically defaults
# to 'local' storage mode (persisting to .storage/s3-bucket) for 100% free,
# zero-setup local development and demonstration.
STORAGE_PROVIDER=local

# ----------------- AWS S3 Configuration (Optional for Local) -----------------
AWS_REGION=us-east-1
S3_BUCKET_NAME=securevault-cloud-storage-demo
# Provide AWS credentials ONLY when STORAGE_PROVIDER=s3 or testing real AWS:
# AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
# AWS_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# AWS_SESSION_TOKEN= (Optional, for temporary STS credentials)

# ----------------- Amazon CloudFront CDN Configuration -----------------
CLOUDFRONT_DOMAIN=d111111abcdef8.cloudfront.net
CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC
WEBSITE_HOSTING_BUCKET=securevault-website-hosting-demo

# ----------------- Security & Limits -----------------
MAX_FILE_SIZE_BYTES=104857600 # 100 MB max file upload limit
MAX_BLOCK_SIZE_BYTES=5242880  # 5 MB max block size
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX_REQUESTS=500
